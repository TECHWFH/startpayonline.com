            font-size: 1.1rem;
            font-weight: 700;
            color: #ffffff;
            cursor: pointer;
            line-height: 1.3;
        }

        .card-body {
            padding: 0 16px;
        }

        .card ul {
            list-style: none;
            margin-bottom: 15px;
        }

        /* Colorful & Highlighted Item Rows */
        .card ul li {
            font-size: 0.88rem;
            color: #334155;
            padding: 8px 10px;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 8px;
            background: #f8fafc;
            border: 1px solid #f1f5f9;
            transition: all 0.2s ease;
            user-select: none;
        }

        .card ul li:hover {
            background: #eef2ff;
            border-color: #c7d2fe;
            color: #1e40af;
        }

        .item-left {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .card ul li i {
            font-size: 0.8rem;
            color: #2563eb;
            pointer-events: none;
        }

