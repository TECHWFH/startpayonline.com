    function refreshVehicleLanguage(){
      document.querySelectorAll('.vehicle-i18n').forEach(el=>{el.textContent=el.dataset[currentLang]||el.dataset.hi;el.title=el.dataset.hi;});
      document.querySelectorAll('.vehicle-item button').forEach(b=>{b.textContent=currentLang==='en'?'Ask ↗':'पूछें ↗';b.title='WhatsApp पर '+b.dataset.service+' की जानकारी पूछें';});
      document.querySelectorAll('.vehicle-card-action-label').forEach(el=>el.textContent=currentLang==='en'?'Ask on WhatsApp':'WhatsApp पर पूछें');
    }
    function normalizeSearch(t){return String(t||'').normalize('NFKC').toLocaleLowerCase().trim();}
    function filterAllServices(){
      const q=normalizeSearch(document.getElementById('vehicle-search').value);
      let total=0;
      document.querySelectorAll('.vehicle-group').forEach(group=>{
        let visible=false;
        group.querySelectorAll('.vehicle-item').forEach(item=>{
          const match=!q||normalizeSearch([item.dataset.hi,item.dataset.en,group.dataset.hi,group.dataset.en,item.innerText].join(' ')).includes(q);
          item.hidden=!match;if(match){visible=true;total++;}
        });group.hidden=!visible;
      });
      document.querySelectorAll('.cards-grid .card').forEach(card=>{
        const head=card.querySelector('h3');
        const headerText=[head?.innerText||'',head?.className||''];
        let visible=false;
        card.querySelectorAll('li').forEach(li=>{
          const cls=Array.from(li.classList).find(c=>/^t\d+-item\d+$/.test(c));
          const key=cls?cls.replace(/-item(\d+)$/,(_,n)=>'Item'+n).replace(/^t(\d+)/,(_,n)=>'t'+n):'';
          const hi=key?translations.hi[key]||'':'';
          const en=key?translations.en[key]||'':'';
          const headingClass=head?.className.match(/t(\d+)-head/)?.[1];
          const hHi=headingClass?translations.hi['t'+headingClass+'Head']||'':'';
          const hEn=headingClass?translations.en['t'+headingClass+'Head']||'':'';
          const match=!q||normalizeSearch([li.innerText,hi,en,hHi,hEn,...headerText].join(' ')).includes(q);
          li.hidden=!match;if(match){visible=true;total++;}
        });
        card.hidden=!visible;
      });
      document.getElementById('all-search-empty').hidden=total!==0;
    }
    document.getElementById('vehicle-search').addEventListener('input',filterAllServices);
    function allServiceNames(){
      const names=[];
      document.querySelectorAll('.cards-grid .card li, .vehicle-item').forEach(el=>{
        const name=el.classList.contains('vehicle-item')?el.dataset.hi:(el.querySelector('.item-left')?.innerText||el.innerText).trim();
        if(name&&!el.hidden&&!el.closest('[hidden]'))names.push(name);
      });
      return names;
    }
