function askVehicleGroup(event,link){
  event.preventDefault();
  const group=link.closest('.vehicle-group');
  const title=group?.dataset.hi||link.dataset.group||'वाहन सेवा';
  const visibleItems=[...(group?.querySelectorAll('.vehicle-item:not([hidden])')||[])];
