        .tag-green { background: #dcfce7; color: #166534; }
        .tag-orange { background: #ffedd5; color: #9a3412; }
        .tag-purple { background: #f3e8ff; color: #6b21a8; }

        .card-action-box {
            padding: 0 16px;
        }

        .card-action {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 0.88rem;
            font-weight: 700;
            text-decoration: none;
            color: #ffffff;
            background: #16a34a;
            padding: 10px;
            border-radius: 10px;
